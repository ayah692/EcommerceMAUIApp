<Shell
    x:Class="EcommerceMAUIApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EcommerceMAUIApp.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="EcommerceMAUIApp">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage"/>

    <ShellContent
        Title="Inventory"
        ContentTemplate="{DataTemplate views:InventoryPage}"
        Route="InventoryPage"/>

    <ShellContent
        Title="Cart"
        ContentTemplate="{DataTemplate views:CartPage}"
        Route="CartPage"/>

    <ShellContent
        Title="Checkout"
        ContentTemplate="{DataTemplate views:CheckoutPage}"
        Route="CheckoutPage"/>
        
  <ShellContent
    Title="Settings"
    ContentTemplate="{DataTemplate views:SettingsPage}"
    Route="SettingsPage"/>

</Shell>
