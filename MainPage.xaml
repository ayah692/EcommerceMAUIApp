<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcommerceMAUIApp.Views.MainPage"
             Title="E-Commerce Menu">

    <ScrollView>
        <VerticalStackLayout Spacing="30" Padding="10">

            <Label Text="Welcome to the E-Commerce App"
                   FontSize="26"
                   HorizontalOptions="Center"
                   FontAttributes="Bold" />

            <!-- Inventory Section -->
            <Grid HeightRequest="200">
                <Image Source="inventory_bg.png" Aspect="AspectFill" />
                <Button Text="🛍️ Go to Inventory"
                        Clicked="GoToInventoryPage"
                        BackgroundColor="#FF5722"
                        TextColor="White"
                        FontSize="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Padding="16,10"
                        CornerRadius="12"/>
            </Grid>

            <!-- Cart Section -->
            <Grid HeightRequest="200">
                <Image Source="cart_bg.png" Aspect="AspectFill" />
                <Button Text="🛒 Go to Cart"
                        Clicked="GoToCartPage"
                        BackgroundColor="#1976D2"
                        TextColor="White"
                        FontSize="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Padding="16,10"
                        CornerRadius="12"/>
            </Grid>

            <!-- Tax Settings Section -->
            <Grid HeightRequest="200">
                <Image Source="tax_bg.png" Aspect="AspectFill" />
                <Button Text="⚙️ Configure Tax Rate"
                        Clicked="GoToSettingsPage"
                        BackgroundColor="#F57C00"
                        TextColor="White"
                        FontSize="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Padding="16,10"
                        CornerRadius="12"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
