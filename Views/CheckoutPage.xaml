<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EcommerceMAUIApp.ViewModels"
             xmlns:models="clr-namespace:EcommerceMAUIApp.Models"
             x:Class="EcommerceMAUIApp.Views.CheckoutPage"
             x:DataType="{x:Type vm:InventoryViewModel}"
             Title="Checkout">

    <VerticalStackLayout Padding="20">
        <Label Text="Receipt"
               FontSize="24"
               HorizontalOptions="Center"/>

        <CollectionView ItemsSource="{Binding ShoppingCart}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <VerticalStackLayout Padding="10">
                        <Label Text="{Binding Name}" FontSize="18"/>
                        <Label Text="{Binding Quantity, StringFormat='Quantity: {0}'}"/>
                        <Label Text="{Binding Price, StringFormat='Price: ${0}'}"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="{Binding Subtotal, StringFormat='Subtotal: ${0:F2}'}"
               FontSize="18"/>
        <Label Text="{Binding Tax, StringFormat='Tax (7%): ${0:F2}'}"
               FontSize="18"/>
        <Label Text="{Binding Total, StringFormat='Total: ${0:F2}'}"
               FontSize="20"
               FontAttributes="Bold"/>

        <Button Text="Complete Purchase"
                Clicked="CompleteCheckout_Clicked"/>

        <Button Text="Go Back"
                Clicked="GoBack_Clicked"
                Margin="0,10,0,0"/>
    </VerticalStackLayout>
</ContentPage>
