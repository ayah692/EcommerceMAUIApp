<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EcommerceMAUIApp.ViewModels"
             xmlns:models="clr-namespace:EcommerceMAUIApp.Models"
             x:Class="EcommerceMAUIApp.Views.InventoryPage"
             x:DataType="{x:Type vm:InventoryViewModel}"
             Title="Inventory">

    <ScrollView>
        <StackLayout Padding="15" Spacing="15">

            <Button Text="← Back to Home"
                    Clicked="GoBackToMain"
                    BackgroundColor="#EEEEEE"
                    TextColor="Black"
                    HorizontalOptions="Start" />

            <Label Text="Inventory"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <HorizontalStackLayout Margin="0,5">
                <Label Text="Sort By:" VerticalOptions="Center" Margin="0,0,10,0" />
                <Picker x:Name="SortPicker" WidthRequest="140" SelectedIndexChanged="OnSortChanged">
                    <Picker.Items>
                        <x:String>Name</x:String>
                        <x:String>Price</x:String>
                    </Picker.Items>
                </Picker>
            </HorizontalStackLayout>

            <CollectionView ItemsSource="{Binding Inventory}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <Frame BackgroundColor="White"
                               CornerRadius="20"
                               Padding="15"
                               Margin="0,10"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" />
                                <Label Text="{Binding Quantity, StringFormat='Quantity: {0}'}" />
                                <Label Text="{Binding Price, StringFormat='Price: ${0:F2}'}" />

                                <HorizontalStackLayout Spacing="10">
                                    <Entry Placeholder="Qty"
                                           WidthRequest="60"
                                           Keyboard="Numeric"
                                           Text="{Binding UserEnteredQuantity, Mode=TwoWay}" />
                                    <Button Text="+" BackgroundColor="Green" TextColor="White"
                                            Clicked="AddCustomQuantity_Clicked" />
                                    <Button Text="Edit" BackgroundColor="#1976D2" TextColor="White"
                                            Clicked="EditProduct_Clicked" />
                                    <Button Text="Delete" BackgroundColor="Red" TextColor="White"
                                            Clicked="DeleteProduct_Clicked" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Add New Product"
                    Clicked="ShowAddProductPopup"
                    BackgroundColor="#FF5722"
                    TextColor="White"
                    CornerRadius="15"
                    HeightRequest="50" />
        </StackLayout>
    </ScrollView>
</ContentPage>
